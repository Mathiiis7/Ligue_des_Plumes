rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper functions
    // ============================================================
    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    // Admin dynamique : lookup dans /admins/{uid} au lieu de UID hardcode.
    // Permet d'ajouter/retirer des admins via Firebase console sans redeploy.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Verifie qu'un champ (path) est bien une string dans les limites [min,max]
    function isBoundedString(field, min, max) {
      return field is string && field.size() >= min && field.size() <= max;
    }
    // Verifie que la resource ne contient QUE les cles autorisees (empeche d'injecter
    // des champs pirates comme "isAdmin=true" ou "score=99999")
    function hasOnlyKeys(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    // ============================================================
    // /admins/{uid} : collection des admins
    // Doc vide, l'UID dans le path suffit. Lecture publique (pour que le
    // client sache si l'user courant est admin). Ecriture uniquement via
    // Firebase console (pas depuis l'app).
    // ============================================================
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;   // manage via Firebase console only
    }

    // ============================================================
    // /leagues/{leagueId}
    // ============================================================
    match /leagues/{leagueId} {

      // Doc racine de la ligue (goalHeader, intitules, etc.)
      // Champs autorises + limites de taille pour eviter les injections.
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && hasOnlyKeys(['goalHeader', 'name', 'createdAt', 'updatedAt'])
        && (!('goalHeader' in request.resource.data) || isBoundedString(request.resource.data.goalHeader, 0, 200))
        && (!('name' in request.resource.data)       || isBoundedString(request.resource.data.name, 0, 100));

      // Membres : chacun ecrit sa fiche, les admins peuvent tout modifier.
      match /members/{memberId} {
        allow read: if isSignedIn();
        allow write: if isSelf(memberId) || isAdmin();
      }

      // Tchat
      match /chat/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && hasOnlyKeys(['uid', 'name', 'text', 'image', 'createdAt', 'replyTo'])
          && (!('name' in request.resource.data) || isBoundedString(request.resource.data.name, 0, 30))
          && (
               (request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500)
               || (request.resource.data.image is string && request.resource.data.image.size() > 0)
             )
          && (!('text' in request.resource.data)  || isBoundedString(request.resource.data.text, 0, 500))
          && (!('image' in request.resource.data) || (request.resource.data.image is string && request.resource.data.image.size() <= 950000));
        allow update: if false;
        allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      }

      // Presence en ligne
      match /presence/{uid} {
        allow read: if isSignedIn();
        allow write: if isSelf(uid)
          && hasOnlyKeys(['at', 'name']);
      }

      // Votes de trophees
      match /votes/{voteId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.voter == request.auth.uid
          && request.resource.data.target != request.auth.uid
          && hasOnlyKeys(['voter', 'target', 'trophy', 'createdAt'])
          && isBoundedString(request.resource.data.trophy, 1, 50)
          && isBoundedString(request.resource.data.target, 1, 128)
          && exists(/databases/$(database)/documents/leagues/$(leagueId)/members/$(request.auth.uid));
        allow delete: if isSignedIn() && (resource.data.voter == request.auth.uid || isAdmin());
        allow update: if false;
      }

      // Photos
      match /photos/{photoId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && hasOnlyKeys(['uid', 'name', 'image', 'caption', 'sci', 'common', 'createdAt', 'lat', 'lng'])
          && request.resource.data.image is string && request.resource.data.image.size() <= 950000
          && (!('caption' in request.resource.data) || isBoundedString(request.resource.data.caption, 0, 200))
          && (!('name'    in request.resource.data) || isBoundedString(request.resource.data.name, 0, 30))
          && (!('sci'     in request.resource.data) || isBoundedString(request.resource.data.sci, 0, 100))
          && (!('common'  in request.resource.data) || isBoundedString(request.resource.data.common, 0, 100));
        allow update: if false;
        allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      }

      // Reactions emoji (chat + photos)
      match /reactions/{rid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && hasOnlyKeys(['uid', 'target', 'emoji', 'createdAt'])
          && isBoundedString(request.resource.data.emoji, 1, 8)      // emoji court, pas de payload
          && isBoundedString(request.resource.data.target, 1, 128);
        allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
        allow update: if false;
      }

      // Commentaires
      match /comments/{cid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && hasOnlyKeys(['uid', 'name', 'text', 'target', 'createdAt'])
          && isBoundedString(request.resource.data.text, 1, 500)
          && isBoundedString(request.resource.data.target, 1, 128)
          && (!('name' in request.resource.data) || isBoundedString(request.resource.data.name, 0, 30));
        allow update: if false;
        allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      }

      // Requetes/suggestions
      match /requests/{reqId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && hasOnlyKeys(['uid', 'name', 'text', 'status', 'createdAt'])
          && isBoundedString(request.resource.data.text, 1, 500)
          && (!('name'   in request.resource.data) || isBoundedString(request.resource.data.name, 0, 30))
          && (!('status' in request.resource.data) || isBoundedString(request.resource.data.status, 0, 20));
        allow update: if isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && (!('status' in request.resource.data) || isBoundedString(request.resource.data.status, 0, 20));
        allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      }

      // Votes de requetes
      match /requestVotes/{voteId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && hasOnlyKeys(['uid', 'requestId', 'createdAt'])
          && isBoundedString(request.resource.data.requestId, 1, 128);
        allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
        allow update: if false;
      }

      // Historique nom (append-only)
      match /nameChanges/{cid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.byUid == request.auth.uid
          && hasOnlyKeys(['byUid', 'targetUid', 'oldName', 'newName', 'at'])
          && (!('oldName' in request.resource.data) || isBoundedString(request.resource.data.oldName, 0, 60))
          && (!('newName' in request.resource.data) || isBoundedString(request.resource.data.newName, 0, 60));
        allow update, delete: if false;
      }

      // Cache eBird partage. Ouvert car les cles sont deterministes cote client
      // et le contenu est de la data publique eBird (bar charts, freq, obs recentes).
      // On limite juste la taille pour eviter les abus.
      match /ebirdCache/{docId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }

      // Evenements trophees
      match /trophyEvents/{eid} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && (!('kind' in request.resource.data) || isBoundedString(request.resource.data.kind, 1, 50))
          && (!('uid'  in request.resource.data) || isBoundedString(request.resource.data.uid, 1, 128));
        allow delete: if isAdmin();
      }

      // Stats quiz
      match /quizStats/{uid} {
        allow read: if isSignedIn();
        allow write: if isSelf(uid) || isAdmin();
      }
    }

    // ============================================================
    // Deny by default : toute autre collection est bloquee tant qu'on n'a
    // pas ecrit ses regles. Empeche d'oublier des permissions sur une
    // nouvelle feature.
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
