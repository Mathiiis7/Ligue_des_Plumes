rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /leagues/{leagueId} {
      // Doc de la ligue (ex. intitulé de colonne) : lecture/écriture par tout utilisateur connecté (anonyme OK)
      allow read, write: if request.auth != null;

      // Membres : chacun voit tout le monde, ecrit sa propre fiche ; les admins
      // (UIDs listes) peuvent aussi retirer / renommer n'importe quel membre.
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (
          request.auth.uid == memberId
          || request.auth.uid == 'pCf1HuUeIkNJTXC0wujsX04UsFs2'
        );
      }

      // Tchat : lecture par tout connecté ; chacun ne crée QUE ses propres messages ;
      // un message doit avoir du texte (1..500) OU une image ; pas de modif/suppression.
      match /chat/{msgId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && (
               (request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500)
               || (request.resource.data.image is string && request.resource.data.image.size() > 0)
             )
          && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 500))
          && (!('image' in request.resource.data) || (request.resource.data.image is string && request.resource.data.image.size() <= 950000));
        allow update: if false;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid; // chacun supprime SES messages
      }

      // Présence "en ligne" : lecture par tout connecté ; chacun n'écrit que sa propre présence.
      match /presence/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // Votes de trophées communautaires (ex. "Gros Bébé") : lecture par tous ;
      // on ne crée QUE son propre vote, pas pour soi-même, et seulement si on est membre.
      match /votes/{voteId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.voter == request.auth.uid
          && request.resource.data.target != request.auth.uid
          && exists(/databases/$(database)/documents/leagues/$(leagueId)/members/$(request.auth.uid));
        allow delete: if request.auth != null && resource.data.voter == request.auth.uid;
        allow update: if false;
      }

      // Photos d'observation : lecture par tous ; chacun poste les siennes et supprime les siennes.
      match /photos/{photoId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.image is string && request.resource.data.image.size() <= 950000
          && (!('caption' in request.resource.data) || (request.resource.data.caption is string && request.resource.data.caption.size() <= 200));
        allow update: if false;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }

      // Réactions emoji (messages du tchat + photos) : lecture par tous ; chacun (dé)pose les siennes.
      match /reactions/{rid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
        allow update: if false;
      }

      // Commentaires (sur photos + observations du fil) : lecture par tous ;
      // chacun poste ses propres commentaires (texte 1..500 chars) ; chacun supprime les siens.
      match /comments/{cid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.target is string;
        allow update: if false;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }

      // Requêtes/suggestions : lecture par tous ; création par l'auteur (texte 1..500 chars) ;
      // suppression par l'auteur ; mise à jour = changement de statut uniquement (admin côté client).
      match /requests/{reqId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }

      // Votes de requêtes : lecture par tous ; chacun (dé)pose son vote.
      match /requestVotes/{voteId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
        allow update: if false;
      }

      // Historique des changements de nom (audit) : lecture par tous ; création uniquement,
      // pas de modif ni suppression (append-only).
      match /nameChanges/{cid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.byUid == request.auth.uid;
        allow update, delete: if false;
      }

      // Cache eBird partage entre les membres : lecture/écriture par tout connecté.
      match /ebirdCache/{docId} {
        allow read, write: if request.auth != null;
      }

      // Evenements trophees (unlock / transfer / demote) : partages entre appareils.
      // Ecrits par n'importe quel membre connecte, avec des IDs deterministes cote client
      // pour eviter les doublons quand plusieurs appareils detectent le meme changement.
      match /trophyEvents/{eid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null;
        allow delete: if false;
      }
    }
  }
}
