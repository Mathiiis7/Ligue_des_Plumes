rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helpers
    // ============================================================
    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isMember(leagueId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/leagues/$(leagueId)/members/$(request.auth.uid));
    }
    function isBoundedString(field, min, max) {
      return field is string && field.size() >= min && field.size() <= max;
    }
    function hasOnlyKeys(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }
    // Verifie qu'un membre existe depuis N jours (anti-manipulation votes/trophees).
    // Grandfathered : si joinedAt manque (vieux membres pre-refonte), autorise sans check.
    function memberOlderThan(leagueId, uid, days) {
      let m = get(/databases/$(database)/documents/leagues/$(leagueId)/members/$(uid)).data;
      return exists(/databases/$(database)/documents/leagues/$(leagueId)/members/$(uid))
        && (!('joinedAt' in m) || m.joinedAt < request.time - duration.value(days, 'd'));
    }

    // ============================================================
    // /admins/{uid} : lecture publique (client verifie si user est admin)
    // ============================================================
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;   // manage via Firebase console only
    }

    // ============================================================
    // /leagues/{leagueId}
    // ============================================================
    match /leagues/{leagueId} {

      // Doc racine : lisible par signed-in (necessaire pour boot). Ecriture admin only.
      allow read: if isSignedIn();
      allow write: if isAdmin()
        && hasOnlyKeys(['goalHeader', 'name', 'createdAt', 'updatedAt'])
        && (!('goalHeader' in request.resource.data) || isBoundedString(request.resource.data.goalHeader, 0, 200))
        && (!('name' in request.resource.data)       || isBoundedString(request.resource.data.name, 0, 100));

      // ------------------------------------------------------------
      // MEMBRES : accessible aux signed-in pour permettre le check "suis-je membre".
      // - Ecriture : chacun sa fiche (upload lifelist), admins peuvent tout.
      // - Lecture : tous les signed-in (car chacun doit pouvoir lire les autres membres
      //   apres son inscription, ET checker sa propre membership avant inscription).
      // ------------------------------------------------------------
      match /members/{memberId} {
        allow read: if isSignedIn();
        allow write: if isSelf(memberId) || isAdmin();
      }

      // ============================================================
      // COLLECTIONS MEMBRES-ONLY : lecture ET ecriture reservees aux membres.
      // Un anon (juste signed-in mais pas inscrit) ne peut RIEN voir ici.
      // ============================================================

      match /chat/{msgId} {
        allow read: if isMember(leagueId) || isAdmin();
        allow create: if isMember(leagueId)
          && request.resource.data.uid == request.auth.uid
          && hasOnlyKeys(['uid', 'name', 'text', 'image', 'createdAt', 'replyTo'])
          && (!('name' in request.resource.data) || isBoundedString(request.resource.data.name, 0, 30))
          && (
               (request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500)
               || (request.resource.data.image is string && request.resource.data.image.size() > 0)
             )
          && (!('text' in request.resource.data)  || isBoundedString(request.resource.data.text, 0, 500))
          && (!('image' in request.resource.data) || (request.resource.data.image is string && request.resource.data.image.size() <= 950000));
        allow update: if false;
        allow delete: if isMember(leagueId) && (resource.data.uid == request.auth.uid || isAdmin());
      }

      match /presence/{uid} {
        allow read: if isMember(leagueId) || isAdmin();
        allow write: if isSelf(uid) && isMember(leagueId)
          && hasOnlyKeys(['at', 'name']);
      }

      // Votes trophees : requiert membre >= 7 jours (anti-manipulation coup rapide)
      match /votes/{voteId} {
        allow read: if isMember(leagueId) || isAdmin();
        allow create: if isMember(leagueId)
          && memberOlderThan(leagueId, request.auth.uid, 7)
          && request.resource.data.voter == request.auth.uid
          && request.resource.data.target != request.auth.uid
          && hasOnlyKeys(['voter', 'target', 'trophy', 'createdAt'])
          && isBoundedString(request.resource.data.trophy, 1, 50)
          && isBoundedString(request.resource.data.target, 1, 128);
        allow delete: if isMember(leagueId) && (resource.data.voter == request.auth.uid || isAdmin());
        allow update: if false;
      }

      match /photos/{photoId} {
        allow read: if isMember(leagueId) || isAdmin();
        allow create: if isMember(leagueId)
          && request.resource.data.uid == request.auth.uid
          && hasOnlyKeys(['uid', 'name', 'image', 'caption', 'sci', 'common', 'createdAt', 'lat', 'lng'])
          && request.resource.data.image is string && request.resource.data.image.size() <= 950000
          && (!('caption' in request.resource.data) || isBoundedString(request.resource.data.caption, 0, 200))
          && (!('name'    in request.resource.data) || isBoundedString(request.resource.data.name, 0, 30))
          && (!('sci'     in request.resource.data) || isBoundedString(request.resource.data.sci, 0, 100))
          && (!('common'  in request.resource.data) || isBoundedString(request.resource.data.common, 0, 100));
        allow update: if false;
        allow delete: if isMember(leagueId) && (resource.data.uid == request.auth.uid || isAdmin());
      }

      match /reactions/{rid} {
        allow read: if isMember(leagueId) || isAdmin();
        allow create: if isMember(leagueId)
          && request.resource.data.uid == request.auth.uid
          && hasOnlyKeys(['uid', 'target', 'emoji', 'createdAt'])
          && isBoundedString(request.resource.data.emoji, 1, 8)
          && isBoundedString(request.resource.data.target, 1, 128);
        allow delete: if isMember(leagueId) && (resource.data.uid == request.auth.uid || isAdmin());
        allow update: if false;
      }

      match /comments/{cid} {
        allow read: if isMember(leagueId) || isAdmin();
        allow create: if isMember(leagueId)
          && request.resource.data.uid == request.auth.uid
          && hasOnlyKeys(['uid', 'name', 'text', 'target', 'createdAt'])
          && isBoundedString(request.resource.data.text, 1, 500)
          && isBoundedString(request.resource.data.target, 1, 128)
          && (!('name' in request.resource.data) || isBoundedString(request.resource.data.name, 0, 30));
        allow update: if false;
        allow delete: if isMember(leagueId) && (resource.data.uid == request.auth.uid || isAdmin());
      }

      match /requests/{reqId} {
        allow read: if isMember(leagueId) || isAdmin();
        allow create: if isMember(leagueId)
          && request.resource.data.uid == request.auth.uid
          && hasOnlyKeys(['uid', 'name', 'text', 'status', 'createdAt'])
          && isBoundedString(request.resource.data.text, 1, 500)
          && (!('name'   in request.resource.data) || isBoundedString(request.resource.data.name, 0, 30))
          && (!('status' in request.resource.data) || isBoundedString(request.resource.data.status, 0, 20));
        allow update: if isMember(leagueId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && (!('status' in request.resource.data) || isBoundedString(request.resource.data.status, 0, 20));
        allow delete: if isMember(leagueId) && (resource.data.uid == request.auth.uid || isAdmin());
      }

      match /requestVotes/{voteId} {
        allow read: if isMember(leagueId) || isAdmin();
        allow create: if isMember(leagueId)
          && request.resource.data.uid == request.auth.uid
          && hasOnlyKeys(['uid', 'requestId', 'createdAt'])
          && isBoundedString(request.resource.data.requestId, 1, 128);
        allow delete: if isMember(leagueId) && (resource.data.uid == request.auth.uid || isAdmin());
        allow update: if false;
      }

      match /nameChanges/{cid} {
        allow read: if isMember(leagueId) || isAdmin();
        allow create: if isMember(leagueId)
          && request.resource.data.byUid == request.auth.uid
          && hasOnlyKeys(['byUid', 'targetUid', 'oldName', 'newName', 'at'])
          && (!('oldName' in request.resource.data) || isBoundedString(request.resource.data.oldName, 0, 60))
          && (!('newName' in request.resource.data) || isBoundedString(request.resource.data.newName, 0, 60));
        allow update, delete: if false;
      }

      match /ebirdCache/{docId} {
        allow read: if isMember(leagueId) || isAdmin();
        allow write: if isMember(leagueId)
          && hasOnlyKeys(['url', 'json', 'updatedAt'])
          && isBoundedString(request.resource.data.url, 1, 500)
          && isBoundedString(request.resource.data.json, 0, 100000);
      }

      match /trophyEvents/{eid} {
        allow read: if isMember(leagueId) || isAdmin();
        allow create, update: if isMember(leagueId)
          && hasOnlyKeys(['kind', 'uid', 'name', 'trophyName', 'fromUid', 'fromName', 'fromTrophy', 'toTrophy', 'at'])
          && isBoundedString(request.resource.data.kind, 1, 30)
          && isBoundedString(request.resource.data.uid, 1, 128)
          && (!('name'        in request.resource.data) || isBoundedString(request.resource.data.name, 0, 60))
          && (!('trophyName'  in request.resource.data) || isBoundedString(request.resource.data.trophyName, 0, 80))
          && (!('fromUid'     in request.resource.data) || request.resource.data.fromUid == null || isBoundedString(request.resource.data.fromUid, 0, 128))
          && (!('fromName'    in request.resource.data) || request.resource.data.fromName == null || isBoundedString(request.resource.data.fromName, 0, 60))
          && (!('fromTrophy'  in request.resource.data) || isBoundedString(request.resource.data.fromTrophy, 0, 80))
          && (!('toTrophy'    in request.resource.data) || isBoundedString(request.resource.data.toTrophy, 0, 80));
        allow delete: if isAdmin();
      }

      match /quizStats/{uid} {
        allow read: if isMember(leagueId) || isAdmin();
        allow write: if isSelf(uid) && isMember(leagueId);
      }
    }

    // ============================================================
    // Deny-by-default catch-all
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
